<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Akzentfarbe für die Fluent-Basissteuerelemente (Sliders, ProgressBar, ToggleSwitch …) -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
            <Color x:Key="SystemAccentColor">#7BC043</Color>
            <Color x:Key="SystemAccentColorDark1">#5F9930</Color>
            <Color x:Key="SystemAccentColorDark2">#4D7E26</Color>
            <Color x:Key="SystemAccentColorDark3">#3B641D</Color>
            <Color x:Key="SystemAccentColorLight1">#8ED55A</Color>
            <Color x:Key="SystemAccentColorLight2">#A1E173</Color>
            <Color x:Key="SystemAccentColorLight3">#B5ED8C</Color>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- Kulka Client Palette -->
    <SolidColorBrush x:Key="BgWindow" Color="#14161A" />
    <SolidColorBrush x:Key="BgSidebar" Color="#0F1114" />
    <SolidColorBrush x:Key="BgCard" Color="#1B1E23" />
    <SolidColorBrush x:Key="BgCardHover" Color="#242830" />
    <SolidColorBrush x:Key="BgInput" Color="#12151A" />
    <SolidColorBrush x:Key="BorderSubtle" Color="#2A2E37" />
    <SolidColorBrush x:Key="BorderStrong" Color="#3A404C" />
    <SolidColorBrush x:Key="TextPrimary" Color="#E8EAED" />
    <SolidColorBrush x:Key="TextSecondary" Color="#9AA3AF" />
    <SolidColorBrush x:Key="Accent" Color="#7BC043" />
    <SolidColorBrush x:Key="AccentHover" Color="#8ED455" />
    <SolidColorBrush x:Key="AccentPressed" Color="#5F9930" />
    <SolidColorBrush x:Key="AccentSoft" Color="#1E2B14" />
    <SolidColorBrush x:Key="TextOnAccent" Color="#0D1306" />
    <SolidColorBrush x:Key="SidebarSelectedBg" Color="#1E2B14" />
    <SolidColorBrush x:Key="SidebarSelectedFg" Color="#7BC043" />
    <SolidColorBrush x:Key="Danger" Color="#E5484D" />
    <SolidColorBrush x:Key="DangerSoft" Color="#332020" />
    <SolidColorBrush x:Key="Warning" Color="#F0A340" />
    <SolidColorBrush x:Key="WarningSoft" Color="#33291A" />
    <SolidColorBrush x:Key="Success" Color="#46A758" />
</ResourceDictionary>
