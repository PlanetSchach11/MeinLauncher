<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MeinLauncher.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="940" d:DesignHeight="700"
             x:Class="MeinLauncher.Views.Settings.GeneralSettingsView"
             x:DataType="vm:SettingsViewModel">

    <ScrollViewer>
        <WrapPanel ItemSpacing="16">

            <!-- Profil / Spielername -->
            <Border Classes="card" Padding="26" MinWidth="360" MaxWidth="430">
                <StackPanel Spacing="10">
                    <TextBlock Text="{Binding L.SettingsProfile}" Classes="section" />

                    <TextBlock Text="{Binding L.SettingsUsername}" Classes="fieldlabel" Margin="0,6,0,0" />
                    <TextBox Text="{Binding Username}" PlaceholderText="{Binding L.SettingsUsernamePlaceholder}"
                             MinWidth="240" />

                    <TextBlock Text="{Binding L.SettingsUsernameHint}" Classes="subtle" FontSize="12"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </WrapPanel>
    </ScrollViewer>
</UserControl>
